-- Table names must match the CSV filenames without the .csv extension.

Clients = COUNTROWS(client_scores)
Defaults = SUM(client_scores[default_flag])
Default Rate = DIVIDE([Defaults], [Clients])
Mean PD = AVERAGE(client_scores[pd])
Mean Risk Score = AVERAGE(client_scores[risk_score])

-- Model Quality page: one model and one split should be selected.
ROC AUC = SELECTEDVALUE(metrics[roc_auc])
Brier Score = SELECTEDVALUE(metrics[brier])

-- Create as a calculated table. Do not create relationships for Capacity.
Capacity = DATATABLE("Fraction", DOUBLE, {{0.05}, {0.10}, {0.20}})

-- Review queue on the test sample only.
Reviewed Defaults =
VAR Budget = SELECTEDVALUE(Capacity[Fraction], 0.10)
VAR Pool = FILTER(ALL(client_scores), client_scores[split] = "test")
VAR N = ROUNDUP(COUNTROWS(Pool) * Budget, 0)
VAR Queue = TOPN(N, Pool, client_scores[pd], DESC, client_scores[client_id], ASC)
RETURN SUMX(Queue, client_scores[default_flag])

Reviewed Clients =
VAR Budget = SELECTEDVALUE(Capacity[Fraction], 0.10)
RETURN
    ROUNDUP(
        COUNTROWS(FILTER(ALL(client_scores), client_scores[split] = "test")) * Budget,
        0
    )

Review Precision = DIVIDE([Reviewed Defaults], [Reviewed Clients])

Review Capture =
DIVIDE(
    [Reviewed Defaults],
    SUMX(
        FILTER(ALL(client_scores), client_scores[split] = "test"),
        client_scores[default_flag]
    )
)

Review Lift =
DIVIDE(
    [Review Precision],
    AVERAGEX(
        FILTER(ALL(client_scores), client_scores[split] = "test"),
        client_scores[default_flag]
    )
)
